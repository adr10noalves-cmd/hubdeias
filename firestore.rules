rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo compartilhado de IAs
    match /ias/{iaId} {
      allow read: if true;
      allow write: if true;
    }

    // Central de Ideias e Projetos
    match /ideas/{ideaId} {
      allow read: if true;
      allow write: if true;
    }

    // Histórico de versões de ideias
    match /idea_versions/{versionId} {
      allow read: if true;
      allow write: if true;
    }

    // Diário de evolução e pensamentos
    match /evolution_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Banco de estudos
    match /studies/{studyId} {
      allow read: if true;
      allow write: if true;
    }

    // Histórico de revisões e melhorias infinitas com IA
    match /project_revisions/{revisionId} {
      allow read: if true;
      allow write: if true;
    }

    // Histórico de execuções operacionais e simulações do Assistente
    match /operational_executions/{executionId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

